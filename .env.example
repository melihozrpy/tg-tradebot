# ==== MERGEN QUANT - Akilli BIST Analiz ve Risk Sistemi - Ornek Ayarlar ====

# ==== Telegram ====
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_USER_IDS=123456789
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ==== App ====
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./mergen_quant.db

# ==== Data providers (mock: sadece test/gelistirme, csv: yerel EOD dosyalari, yfinance: ucretsiz gercek BIST verisi) ====
MARKET_DATA_PROVIDER=yfinance
KAP_PROVIDER=disabled
BROKER_FLOW_PROVIDER=disabled
FUNDAMENTAL_PROVIDER=disabled
CSV_DATA_DIR=./data_csv
YFINANCE_TIMEOUT_SECONDS=10
YFINANCE_MAX_RETRIES=3

# ==== Asama 5d: provider retry / circuit breaker / fallback / kalici veri cache ==== 
PROVIDER_RETRY_MAX_ATTEMPTS=2
PROVIDER_RETRY_BASE_SECONDS=1.0
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_RECOVERY_SECONDS=120
YAHOO_CHART_FALLBACK_ENABLED=true
DATA_CACHE_DIR=./data/cache/ohlcv
DATA_CACHE_MAX_AGE_DAILY_MINUTES=720
DATA_CACHE_MAX_AGE_INTRADAY_MINUTES=30
# unadjusted | adjusted (OHLC tek bir fiyat modu ile tutarlı tutulur)
TECHNICAL_PRICE_MODE=unadjusted
PRICE_ADJUSTMENT_MODE=adjusted

# ==== V3: XU100 / piyasa rejimi ====
XU100_SYMBOL=XU100.IS

# ==== V3: Gun ici on analiz / kesinlesmis kapanis ayrimi ====
INTRADAY_PREVIEW_ENABLED=true
CONFIRMED_CLOSE_REQUIRED=true
CLOSE_SCAN_ENABLED=false
CLOSE_SCAN_TIME=18:20
CLOSE_SCAN_RETRY_MINUTES=15
CLOSE_SCAN_MAX_RETRIES=4
TIMEZONE_NAME=Europe/Istanbul

# ==== V3: Skor / risk esikleri (varsayilanlar; /ayarlar ile kullanici bazinda degistirilebilir) ====
MINIMUM_SIGNAL_SCORE=65
MINIMUM_RISK_REWARD=2.0
RISK_PER_TRADE_PERCENT=0.75
MAXIMUM_POSITION_PERCENT=20
MAXIMUM_SECTOR_EXPOSURE_PERCENT=30

# ==== V3: Cache (yfinance rate-limit korumasi) ====
CACHE_ENABLED=true
DAILY_CACHE_TTL_MINUTES=30
INTRADAY_CACHE_TTL_MINUTES=5
YFINANCE_REQUEST_DELAY_SECONDS=1.0

# ==== V3: Kamuya acik bildirim (KAP yerine; varsayilan devre disi) ====
PUBLIC_DISCLOSURE_PROVIDER=disabled

# ==== V3: Sektor / sembol evreni ====
SECTOR_MAP_PATH=app/config/sector_map.yaml
BIST_SYMBOLS_CSV_PATH=data/symbols/bist_symbols.csv

# ==== V3: Performans raporu ====
PERFORMANCE_MINIMUM_SAMPLE_SIZE=20

# ==== V3: Sinyal yasam dongusu ====
SIGNAL_EXPIRY_TRADING_DAYS=10
CONSERVATIVE_EXECUTION=true

# ==== V3.1: Gun ici onizleme zaman dilimi (/gunici) ====
INTRADAY_SNAPSHOT_TIMEFRAME=15m
INTRADAY_MAX_LAG_MINUTES=30

# ==== V3.1: Coklu zaman dilimi motoru (/zaman_dilimleri) ====
MULTI_TIMEFRAME_ENABLED=true
TIMEFRAMES=5m,15m,1h,4h,1d,1wk
TIMEFRAME_WEIGHT_WEEKLY=30
TIMEFRAME_WEIGHT_DAILY=25
TIMEFRAME_WEIGHT_4H=20
TIMEFRAME_WEIGHT_1H=15
TIMEFRAME_WEIGHT_15M=7
TIMEFRAME_WEIGHT_5M=3

# ==== V3.1: Likidite filtresi (/likidite) ====
LIQUIDITY_FILTER_ENABLED=true
MINIMUM_AVERAGE_VOLUME=100000
MINIMUM_AVERAGE_TURNOVER_TRY=5000000
MAXIMUM_ATR_PERCENT=12
STRONG_SIGNAL_MINIMUM_LIQUIDITY_SCORE=45

# ==== V3.2 (Asama 4): GDELT haber radari (/haberler, /haber_detay, /haber_radari) ====
GDELT_ENABLED=true
GDELT_TIMEOUT_SECONDS=20
GDELT_MAX_RETRIES=2
NEWS_CACHE_TTL_MINUTES=30

# ==== Asama 5d: gelişmiş alarm taraması ====
ENHANCED_ALARM_SCAN_ENABLED=true
ENHANCED_ALARM_SCAN_MINUTES=15
ENHANCED_ALARM_DEFAULT_COOLDOWN_MINUTES=120
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_TIME=09:10
# Resmi oran otomatik bagli degilse bos birakin; eski/uydurma veri gosterilmez.
TCMB_POLICY_RATE_PERCENT=
BREAKOUT_MINIMUM_VOLUME_RATIO=1.2

# ==== Asama 5d: profesyonel grafik ve grafik cache ====
CHART_DPI=120
CHART_WIDTH=13
CHART_HEIGHT=11
# light | dark
CHART_THEME=light
CHART_CACHE_TTL_MINUTES=30
CHART_CACHE_DIR=./data/cache/charts

# ==== V3.2 (Asama 4): Groq (opsiyonel, yalnizca sade Turkce aciklama uretir) ====
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2
GROQ_DAILY_REQUEST_LIMIT=50

# ==== Risk varsayilanlari ====
DEFAULT_TOTAL_CAPITAL=100000

# ==== Asama 5g: Backtest, walk-forward ve sanal islem ====
# Baz puan (bps): 10 bps = %0.10. Varsayilanlar masrafsiz degildir.
BACKTEST_COMMISSION_BPS=15
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_SPREAD_BPS=10
BACKTEST_BSMV_BPS=0
BACKTEST_MINIMUM_COST=0
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_MAX_POSITION_PCT=20
# conservative | optimistic | nearest_to_open | lower_timeframe
BACKTEST_INTRABAR_POLICY=conservative
# next_open | next_vwap | next_close
BACKTEST_ENTRY_MODEL=next_open
BACKTEST_MINIMUM_SAMPLE_SIZE=30
BACKTEST_MAX_CONCURRENT_PER_USER=1
BACKTEST_TIMEOUT_SECONDS=600
WALK_FORWARD_TRAIN_DAYS=504
WALK_FORWARD_VALIDATION_DAYS=126
WALK_FORWARD_TEST_DAYS=126
WALK_FORWARD_STEP_DAYS=126
WALK_FORWARD_MODE=rolling
CALIBRATION_MINIMUM_SAMPLE_SIZE=30
PAPER_TRADING_INITIAL_CAPITAL=100000
PAPER_TRADING_SCAN_MINUTES=15

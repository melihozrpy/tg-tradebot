# ==== MERGEN QUANT - Akilli BIST Analiz ve Risk Sistemi - Ornek Ayarlar ====

# ==== Telegram ====
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_USER_IDS=123456789
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ==== App ====
APP_ENV=development
LOG_LEVEL=INFO
BOT_NAME=Montana Finans Robotu
DATABASE_URL=sqlite:///./mergen_quant.db

# ==== Data providers (mock: sadece test/gelistirme, csv: yerel EOD dosyalari, yfinance: ucretsiz gercek BIST verisi) ====
MARKET_DATA_PROVIDER=yfinance
# Canli alarm/sinyal icin sozlesmeli veri dagiticisinin REST gateway'i:
# MARKET_DATA_PROVIDER=licensed_rest yapin ve sir degerleri Coolify'da tanimlayin.
LICENSED_MARKET_DATA_BASE_URL=
LICENSED_MARKET_DATA_API_KEY=
LICENSED_MARKET_DATA_API_KEY_HEADER=X-API-Key
LICENSED_MARKET_DATA_QUOTE_PATH=/quote/{symbol}
LICENSED_MARKET_DATA_OHLCV_PATH=/ohlcv/{symbol}
LICENSED_MARKET_DATA_MARKET_STATE_PATH=/market-state
LICENSED_MARKET_DATA_PROVIDER_NAME=licensed_rest
LICENSED_MARKET_DATA_TIMEOUT_SECONDS=10
KAP_PROVIDER=disabled
BROKER_FLOW_PROVIDER=disabled
# disabled | auto | fintables_mcp | kap_rest | yahoo
FUNDAMENTAL_PROVIDER=auto
FUNDAMENTAL_CROSS_CHECK_ENABLED=false
FUNDAMENTAL_CROSS_CHECK_STRICT=true
# Yetkili Fintables/KAP yoksa Yahoo gecikmeli ve acikca ikincil kaynak olarak kullanilir.
FUNDAMENTAL_ALLOW_SECONDARY_FALLBACK=true
FUNDAMENTAL_ALLOW_YAHOO_FALLBACK=true
FUNDAMENTAL_TIMEOUT_SECONDS=20

# Fintables: kullanici/lisans sahibi OAuth bearer tokeni ve MCP arac adi gerekir.
# Tokeni repoya yazmayin; Coolify secret/environment alaninda tanimlayin.
FINTABLES_MCP_URL=https://evo.fintables.com/mcp
FINTABLES_MCP_BEARER_TOKEN=
FINTABLES_MCP_TOOL_NAME=
FINTABLES_MCP_SYMBOL_ARGUMENT=symbol

# KAP REST: Borsa Istanbul veri dagitim sozlesmesi ve API anahtari gerekir.
KAP_REST_BASE_URL=
KAP_REST_API_KEY=
KAP_REST_ENDPOINT_PATH=/fundamentals/{symbol}
KAP_REST_API_KEY_HEADER=X-API-Key
KAP_REST_DISCLOSURES_PATH=/disclosures
KAP_REST_DISCLOSURE_DETAIL_PATH=/disclosureDetail/{id}
KAP_REST_SYMBOL_QUERY_PARAM=symbol
CSV_DATA_DIR=./data_csv
YFINANCE_TIMEOUT_SECONDS=10
YFINANCE_MAX_RETRIES=3

# ==== Asama 5d: provider retry / circuit breaker / fallback / kalici veri cache ==== 
PROVIDER_RETRY_MAX_ATTEMPTS=2
PROVIDER_RETRY_BASE_SECONDS=1.0
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_RECOVERY_SECONDS=120
YAHOO_CHART_FALLBACK_ENABLED=true
DATA_CACHE_DIR=./data/cache/ohlcv
DATA_CACHE_MAX_AGE_DAILY_MINUTES=720
DATA_CACHE_MAX_AGE_INTRADAY_MINUTES=30
# unadjusted | adjusted (OHLC tek bir fiyat modu ile tutarlı tutulur)
TECHNICAL_PRICE_MODE=unadjusted
PRICE_ADJUSTMENT_MODE=adjusted

# ==== V3: XU100 / piyasa rejimi ====
XU100_SYMBOL=XU100.IS

# ==== V3: Gun ici on analiz / kesinlesmis kapanis ayrimi ====
INTRADAY_PREVIEW_ENABLED=true
CONFIRMED_CLOSE_REQUIRED=true
CLOSE_SCAN_ENABLED=false
CLOSE_SCAN_TIME=18:20
CLOSE_SCAN_RETRY_MINUTES=15
CLOSE_SCAN_MAX_RETRIES=4
TIMEZONE_NAME=Europe/Istanbul

# ==== SMXM 09:00 / 21:00 raporlari ve config tabanli enstruman listesi ====
# JSON dizi veya virgul ile ayrilmis liste kullanilabilir. XU100 rapora otomatik eklenir.
INSTRUMENTS=["THYAO","ASELS","KCHOL","GARAN","AKBNK","SASA","BIMAS","EREGL","TCELL","FROTO","EURUSD","XAUUSD","XAGUSD","US100"]
BIST_UNIVERSE_JSON_PATH=app/config/bist_instruments.json
MORNING_REPORT_ENABLED=true
MORNING_REPORT_TIME=09:00
EVENING_MARKET_REPORT_ENABLED=true
EVENING_MARKET_REPORT_TIME=21:00
REPORT_CHART_OUTPUT_DIR=/tmp/mergen_quant_reports
REPORT_MAX_NEWS_EVENTS=8
REPORT_KAP_SYMBOL_LIMIT=20
ECONOMIC_CALENDAR_ENABLED=true
ECONOMIC_CALENDAR_URL=https://tr.investing.com/economic-calendar/
ECONOMIC_CALENDAR_TIMEOUT_SECONDS=15
VIX_SYMBOL=^VIX
DXY_SYMBOL=DX-Y.NYB

# ==== Tum Hisseler / en iyi giris taramasi ====
UNIVERSE_SCAN_TOP_N=50
UNIVERSE_SCAN_MAX_SYMBOLS_PER_RUN=1000
UNIVERSE_SCAN_WORKERS=3
UNIVERSE_SCAN_CACHE_MINUTES=60
UNIVERSE_SCAN_MINIMUM_SCORE=68

# ==== Ortak indikator / kademeli entry / tam evren teknik tarama ====
STAGED_ENTRY_ENABLED=true
STAGED_ENTRY_ALLOCATIONS=40,35,25
TECHNICAL_SCREENER_ENABLED=true
TECHNICAL_SCREENER_INTERVAL_MINUTES=30
TECHNICAL_SCREENER_MIN_CONFLUENCE=3
TECHNICAL_SCREENER_WORKERS=3
# Tek Telegram kanal/grup chat ID. Bos ise admin kullanicilara gider.
TECHNICAL_SCREENER_CHAT_ID=
TECHNICAL_SCREENER_MAX_SYMBOLS_PER_RUN=1000
RSI_OVERBOUGHT=75
RSI_OVERSOLD=25
INTRADAY_VWAP_SCAN_ENABLED=true
INTRADAY_VWAP_SCAN_MINUTE_STEP=30
# RSI tek başına bildirim üretmez. 15 dakikalık kart sadece 3+ bağımsız teyitli senaryoları gönderir.
TRADE_SCENARIO_SCAN_ENABLED=true
TRADE_SCENARIO_SCAN_MINUTES=180
TRADE_SCENARIO_MAX_RESULTS=5
# VWAP + EMA + RSI + ATR + MACD icinden ayni yone minimum uyum.
TRADE_SCENARIO_MINIMUM_CORE_CONFIRMATIONS=3
TRADE_SCENARIO_MINIMUM_TEN_CONFIRMATIONS=7
# Saat baslarinda (BIST acikken) gunluk teknik + temel dogrulamali ilk 5 long adayi.
# %3, garanti getiri degil; gercek direncte hesaplanan minimum potansiyel filtresidir.
DAILY_TOP_PICKS_ENABLED=true
DAILY_TOP_PICKS_MAX_RESULTS=5
DAILY_TOP_PICKS_MINIMUM_CONFIRMATIONS=6
DAILY_TOP_PICKS_FUNDAMENTAL_CANDIDATES=20
DAILY_TOP_PICKS_REQUIRE_FUNDAMENTAL=true
MARKET_OPPORTUNITY_MAX_RESULTS=8
# /firsatlar 5dk|1s|4s: ortak 10 gostergeden gereken minimum teyit.
MARKET_OPPORTUNITY_MINIMUM_CONFLUENCE=5

# /haber sembol ozeti: ayni sembol icin DB cache ve opsiyonel robots-uyumlu sayfalar.
NEWS_DIGEST_CACHE_MINUTES=15
NEWS_DIGEST_LOOKBACK_HOURS=48
# Virgullu URL sablonlari; {symbol} ve {company} kullanilabilir. Bosken GDELT+KAP kullanilir.
NEWS_SCRAPE_URLS=

# ==== V3: Skor / risk esikleri (varsayilanlar; /ayarlar ile kullanici bazinda degistirilebilir) ====
MINIMUM_SIGNAL_SCORE=65
MINIMUM_RISK_REWARD=2.0
RISK_PER_TRADE_PERCENT=0.75
MAXIMUM_POSITION_PERCENT=20
MAXIMUM_SECTOR_EXPOSURE_PERCENT=30

# ==== V3: Cache (yfinance rate-limit korumasi) ====
CACHE_ENABLED=true
DAILY_CACHE_TTL_MINUTES=30
INTRADAY_CACHE_TTL_MINUTES=5
YFINANCE_REQUEST_DELAY_SECONDS=1.0

# ==== V3: Kamuya acik bildirim (KAP yerine; varsayilan devre disi) ====
PUBLIC_DISCLOSURE_PROVIDER=disabled

# ==== V3: Sektor / sembol evreni ====
SECTOR_MAP_PATH=app/config/sector_map.yaml
BIST_SYMBOLS_CSV_PATH=data/symbols/bist_symbols.csv

# ==== V3: Performans raporu ====
PERFORMANCE_MINIMUM_SAMPLE_SIZE=20

# ==== V3: Sinyal yasam dongusu ====
SIGNAL_EXPIRY_TRADING_DAYS=10
CONSERVATIVE_EXECUTION=true

# ==== Ultra BIST: canli sinyal, parcali hedef ve gercekci emir kurallari ====
LONG_ONLY=true
SIGNAL_MONITOR_ENABLED=true
SIGNAL_MONITOR_INTERVAL_SECONDS=5
ALLOW_DELAYED_DATA_FOR_LIVE_TRIGGER=false
# Bos birakilirsa canli sinyal motoru provider/servis politikasindan daha gevsek
# davranmaz; deger verilecekse saniye cinsinden pozitif bir tamsayi olmalidir.
MAX_MARKET_DATA_STALENESS_SECONDS=
DEFAULT_RISK_PERCENT=1.0
MAX_POSITION_PERCENT=20
MAX_DAILY_VOLUME_PARTICIPATION_PERCENT=1
DEFAULT_TP1_ALLOCATION=40
DEFAULT_TP2_ALLOCATION=35
DEFAULT_TP3_ALLOCATION=25
MOVE_STOP_TO_BREAKEVEN_AFTER_TP1=true
MOVE_STOP_TO_TP1_AFTER_TP2=true

# ==== V3.1: Gun ici onizleme zaman dilimi (/gunici) ====
INTRADAY_SNAPSHOT_TIMEFRAME=15m
INTRADAY_MAX_LAG_MINUTES=30

# ==== V3.1: Coklu zaman dilimi motoru (/zaman_dilimleri) ====
MULTI_TIMEFRAME_ENABLED=true
TIMEFRAMES=5m,15m,1h,4h,1d,1wk
TIMEFRAME_WEIGHT_WEEKLY=30
TIMEFRAME_WEIGHT_DAILY=25
TIMEFRAME_WEIGHT_4H=20
TIMEFRAME_WEIGHT_1H=15
TIMEFRAME_WEIGHT_15M=7
TIMEFRAME_WEIGHT_5M=3

# ==== V3.1: Likidite filtresi (/likidite) ====
LIQUIDITY_FILTER_ENABLED=true
MINIMUM_AVERAGE_VOLUME=100000
MINIMUM_AVERAGE_TURNOVER_TRY=5000000
MAXIMUM_ATR_PERCENT=12
STRONG_SIGNAL_MINIMUM_LIQUIDITY_SCORE=45

# ==== V3.2 (Asama 4): GDELT haber radari (/haberler, /haber_detay, /haber_radari) ====
GDELT_ENABLED=true
GDELT_TIMEOUT_SECONDS=20
GDELT_MAX_RETRIES=2
NEWS_CACHE_TTL_MINUTES=30

# ==== Asama 5d: gelişmiş alarm taraması ====
ENHANCED_ALARM_SCAN_ENABLED=true
ENHANCED_ALARM_SCAN_MINUTES=15
ENHANCED_ALARM_DEFAULT_COOLDOWN_MINUTES=120
DAILY_BRIEF_ENABLED=false
DAILY_BRIEF_TIME=09:10
# Resmi oran otomatik bagli degilse bos birakin; eski/uydurma veri gosterilmez.
TCMB_POLICY_RATE_PERCENT=
BREAKOUT_MINIMUM_VOLUME_RATIO=1.2

# ==== Kalici kullanici fiyat alarmlari (monitor + guvenilir outbox teslimati) ====
# CLOSE_SCAN_ENABLED=false bu isleri kapatmaz.
USER_PRICE_ALERTS_ENABLED=true
USER_PRICE_ALERT_POLL_SECONDS=30
USER_PRICE_ALERT_DELIVERY_POLL_SECONDS=5
USER_PRICE_ALERT_DEFAULT_REPEAT_SECONDS=60
USER_PRICE_ALERT_MIN_REPEAT_SECONDS=30
USER_PRICE_ALERT_MAX_ACTIVE_PER_USER=500
USER_PRICE_ALERT_MAX_BULK_IMPORT=250
USER_PRICE_ALERT_STALE_AFTER_SECONDS=180
USER_PRICE_ALERT_MAX_DELIVERIES_PER_MINUTE_PER_USER=10
USER_PRICE_ALERT_MAX_GLOBAL_DELIVERIES_PER_MINUTE=500
USER_PRICE_ALERT_AUDIO_ENABLED=true
USER_PRICE_ALERT_OCR_ENABLED=true
USER_PRICE_ALERT_OCR_LANGUAGE=tur+eng
USER_PRICE_ALERT_TEMP_FILE_TTL_MINUTES=30
USER_PRICE_ALERT_MAX_IMAGE_BYTES=10485760
USER_PRICE_ALERT_MAX_FILE_BYTES=10485760

# ==== Asama 5d: profesyonel grafik ve grafik cache ====
CHART_DPI=120
CHART_WIDTH=13
CHART_HEIGHT=11
# light | dark
CHART_THEME=dark
CHART_CACHE_TTL_MINUTES=30
CHART_CACHE_DIR=./data/cache/charts

# ==== V3.2 (Asama 4): Groq (opsiyonel, yalnizca sade Turkce aciklama uretir) ====
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2
GROQ_DAILY_REQUEST_LIMIT=50

# ==== OpenRouter: kapsamli hisse ve grafik fotografi analizi ====
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_FALLBACKS=inclusionai/ling-3.0-flash:free,nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_MODEL_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_TOKENS=3000
OPENROUTER_MAX_RETRIES=2
# 0: bot içinde yapay günlük sınır yok; OpenRouter gerçek sağlayıcı kotası geçerlidir.
OPENROUTER_DAILY_REQUEST_LIMIT=0
OPENROUTER_LOCAL_RATE_LIMIT_ENABLED=false
OPENROUTER_MAX_IMAGE_BYTES=10485760

# ==== Risk varsayilanlari ====
DEFAULT_TOTAL_CAPITAL=100000

# ==== Asama 5g: Backtest, walk-forward ve sanal islem ====
# Yeni point-in-time emir modeli. Eski BACKTEST_ENTRY_MODEL ve
# BACKTEST_INTRABAR_POLICY alanlari geriye uyumluluk icin asagida korunur.
BACKTEST_ENTRY_MODE=next_session_level_touch
BACKTEST_INTRABAR_MODE=lower_timeframe_then_conservative
BACKTEST_FILL_MODEL=conservative_volume_limited
BACKTEST_LIMIT_LOCK_MODE=conservative
BACKTEST_PRICE_MODE=split_adjusted
# Broker sozlesmesine gore doldurun; bos degerler uydurma komisyon sayilmaz.
BACKTEST_COMMISSION_RATE=
BACKTEST_COMMISSION_MINIMUM=
BACKTEST_COMMISSION_TAX_RATE=
BACKTEST_INCLUDE_DIVIDENDS=true
# Baz puan (bps): 10 bps = %0.10. Varsayilanlar masrafsiz degildir.
BACKTEST_COMMISSION_BPS=0
BACKTEST_SLIPPAGE_BPS=0
BACKTEST_SPREAD_BPS=0
BACKTEST_BSMV_BPS=0
BACKTEST_MINIMUM_COST=0
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_MAX_POSITION_PCT=20
# conservative | optimistic | nearest_to_open | lower_timeframe
BACKTEST_INTRABAR_POLICY=conservative
# next_open | next_vwap | next_close
BACKTEST_ENTRY_MODEL=next_open
BACKTEST_MINIMUM_SAMPLE_SIZE=30
BACKTEST_MAX_CONCURRENT_PER_USER=1
BACKTEST_TIMEOUT_SECONDS=600
WALK_FORWARD_TRAIN_DAYS=504
WALK_FORWARD_VALIDATION_DAYS=126
WALK_FORWARD_TEST_DAYS=126
WALK_FORWARD_STEP_DAYS=126
WALK_FORWARD_MODE=rolling
CALIBRATION_MINIMUM_SAMPLE_SIZE=30
PAPER_TRADING_INITIAL_CAPITAL=100000
PAPER_TRADING_SCAN_MINUTES=15

# ==== Coklu sanal portfoy / SMXM risk kurallari ====
VIRTUAL_PORTFOLIO_MAX_PER_USER=3
VIRTUAL_PORTFOLIO_MAX_STRATEGIES=2
VIRTUAL_TRADE_RISK_PERCENT=1.0
VIRTUAL_TRADE_AFTER_LOSS_RISK_PERCENT=0.5
VIRTUAL_TRADE_MINIMUM_RR=2.0
VIRTUAL_TRADE_MINIMUM_CHECKLIST=5
# Python weekday: Pazartesi=0, Cuma=4
VIRTUAL_TRADE_BLOCKED_WEEKDAYS=0,4
